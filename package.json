{
  "name": "barangay179-crime-bi",
  "version": "2.0.0",
  "description": "Barangay 179 Crime Intelligence and Patrol Decision Support System",
  "author": "Barangay 179 Crime BI Capstone Team",
  "main": "main.js",
  "scripts": {
    "postinstall": "cd backend && npm install",
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "db:migrate": "cd backend && node scripts/migrate.js",
    "db:migrate:record-patrol": "node backend/scripts/migrate-record-patrol.js",
    "db:reset:test": "node backend/scripts/reset-test-database.js",
    "db:reset:user-management:test": "node backend/scripts/reset-user-management-test.js",
    "db:import:patrol-fixture": "node backend/scripts/import-patrol-fixture.js",
    "db:seed": "cd backend && node scripts/seed-test-data.js",
    "db:generate:qa": "node backend/generate-records.js",
    "db:verify:qa": "node backend/verify-cart.js --batch qa-cart-map-400-v1",
    "db:admin": "cd backend && node scripts/seed-admin.js",
    "test:analytics": "npm --prefix backend run test:analytics",
    "setup": "npm install && cd backend && node scripts/seed-test-data.js"
  },
  "type": "commonjs",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "maplibre-gl": "5.24.0"
  },
  "build": {
    "appId": "com.barangay179.crimebi",
    "productName": "Barangay 179 Crime BI",
    "copyright": "Barangay 179 Crime BI Capstone Team",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "desktop-policy.js",
      "package.json",
      "backend/**/*",
      "frontend/**/*",
      "database/schema.sql",
      "database/migrations/**/*",
      "!backend/.env",
      "!backend/config.json",
      "!backend/*.log",
      "!backend/uploads/**",
      "!backend/tests/**",
      "!backend/jest.config.js"
    ],
    "extraResources": [
      {
        "from": "backend/node_modules",
        "to": "app/backend/node_modules",
        "filter": [
          "**/*",
          "!.bin",
          "!.cache"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "frontend/icons/icon-512.png",
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Barangay 179 Crime BI",
      "uninstallDisplayName": "Barangay 179 Crime BI",
      "artifactName": "Barangay179-CrimeBI-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
