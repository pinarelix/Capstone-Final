{
  "name": "barangay179-crime-bi",
  "version": "1.0.0",
  "description": "Barangay 179 Crime Intelligence and Patrol Decision Support System",
  "author": "Barangay 179 Crime BI Capstone Team",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "type": "commonjs",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.barangay179.crimebi",
    "productName": "Barangay 179 Crime BI",
    "copyright": "Barangay 179 Crime BI Capstone Team",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "backend/**/*",
      "frontend/**/*",
      "!backend/.env",
      "!backend/*.log",
      "!backend/uploads/**",
      "!backend/tests/**",
      "!backend/jest.config.js"
    ],
    "extraResources": [
      {
        "from": "backend/node_modules",
        "to": "app/backend/node_modules",
        "filter": [
          "**/*",
          "!.bin",
          "!.cache"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "frontend/icons/icon-512.png",
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Barangay 179 Crime BI",
      "uninstallDisplayName": "Barangay 179 Crime BI",
      "artifactName": "Barangay179-CrimeBI-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
