# Copy this file to .env (in this same backend/ folder) and fill in your
# local MySQL credentials. .env is git-ignored — never commit real
# credentials.

# MySQL connection
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=admin
DB_NAME=brgydata

# Port the Express server (and the Electron window) listens on
PORT=3000

# Optional: lets "Forgot Password" actually email a reset code instead
# of only logging it to the Audit Trail for an admin to relay manually.
# EMAIL_USER is the Gmail address sending the email. EMAIL_APP_PASSWORD
# is NOT that account's normal login password - it's a 16-character
# "App Password" generated from Google Account > Security > App
# Passwords, which requires 2-Step Verification to be turned on first.
# Leave both blank to keep using the Audit Trail fallback only.
EMAIL_USER=
EMAIL_APP_PASSWORD=
