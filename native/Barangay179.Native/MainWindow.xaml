<Window x:Class="Barangay179.Native.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Barangay 179 — Native migration preview" Width="1280" Height="820" MinWidth="920" MinHeight="650">
  <Grid>
    <ScrollViewer x:Name="LoginView" VerticalScrollBarVisibility="Auto">
      <StackPanel Width="440" Margin="32,64">
        <TextBlock Text="Barangay 179 Crime BI" FontSize="27" FontWeight="Bold" />
        <TextBlock Text="Native Windows client · Migration preview" Foreground="{StaticResource Muted}" Margin="0,8,0,28" />
        <TextBlock Text="Internal server address" /><TextBox x:Name="ServerAddress" Text="http://localhost:3007" AutomationProperties.Name="Internal server address" />
        <CheckBox x:Name="AllowHttpLan" Content="Allow insecure HTTP on the office LAN" Margin="0,0,0,8" />
        <TextBlock Text="HTTP sends credentials and records unencrypted. Use HTTPS for network connections; localhost HTTP is allowed." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,20" />
        <TextBlock Text="Username" /><TextBox x:Name="Username" MaxLength="100" AutomationProperties.Name="Username" />
        <TextBlock Text="Password" /><PasswordBox x:Name="Password" AutomationProperties.Name="Password" />
        <Button x:Name="LoginButton" Content="Sign in" Click="Login_Click" IsDefault="True" HorizontalAlignment="Left" />
        <TextBlock x:Name="LoginStatus" TextWrapping="Wrap" Foreground="#B91C1C" Margin="0,16,0,0" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="This preview supports eligible record browsing, native CART pin plotting, detail inspection and patrol-note editing. Other workflows remain in the existing app." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,30,0,0" />
      </StackPanel>
    </ScrollViewer>
    <Grid x:Name="Workspace" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Background="#F1F5F9" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <DockPanel Margin="20">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="◈  Barangay 179" FontSize="22" FontWeight="Bold" /><TextBlock Text="Crime BI · Native preview" Margin="0,6,0,20" Foreground="{StaticResource Muted}" />
            <Separator />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <Separator /><TextBlock x:Name="AccountLabel" TextWrapping="Wrap" Margin="0,16,0,12" /><Button Content="Sign out" Click="Logout_Click" />
          </StackPanel>
          <StackPanel Margin="0,16,0,0">
            <RadioButton x:Name="RecordsNav" Content="▤  Patrol-eligible records" GroupName="Navigation" IsChecked="True" Checked="Navigation_Changed" Padding="10" Margin="0,0,0,12" />
            <RadioButton x:Name="MapNav" Content="⌖  CART record pins" GroupName="Navigation" Checked="Navigation_Changed" Padding="10" />
            <TextBlock Text="The navigation panel stays mounted while views switch. No HTML or embedded browser is used." TextWrapping="Wrap" Margin="10,28,10,0" Foreground="{StaticResource Muted}" FontSize="12" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel><Button x:Name="RefreshButton" Content="Refresh records" DockPanel.Dock="Right" Click="Refresh_Click" /><TextBlock Text="Patrol record analysis" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" /></DockPanel>
        <StackPanel Grid.Row="1" Margin="0,18,0,8"><TextBlock x:Name="ThresholdLabel" /><TextBox x:Name="Search" TextChanged="Search_Changed" AutomationProperties.Name="Filter records by number, type or address" ToolTip="Filter by record number, type or exact address" /></StackPanel>
        <Grid Grid.Row="2">
          <ListBox x:Name="RecordsList" MouseDoubleClick="Records_Open" KeyDown="Records_KeyDown" AutomationProperties.Name="Patrol records ordered by CART score">
            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Subheading}" Margin="0,5,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <Grid x:Name="MapView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock Text="Geographic pin plot — no street basemap. Select a pin for its exact address and record. Overlapping pins open a grouped list." TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{StaticResource Muted}" />
            <Canvas x:Name="PinCanvas" Grid.Row="1" Background="#F8FAFC" ClipToBounds="True" SizeChanged="Canvas_Changed" />
          </Grid>
        </Grid>
        <StackPanel Grid.Row="3"><Button x:Name="OpenButton" Content="Open selected record" HorizontalAlignment="Left" Click="Records_Open" /><TextBlock x:Name="Status" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
